<?xml version="1.0" encoding="utf-8"?>
<!-- The app makes no network connections. Cleartext is denied and only system CAs are trusted
     as a defence in depth in case a future change ever adds networking. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
