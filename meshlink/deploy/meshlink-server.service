[Unit]
Description=MeshLink coordination server and WireGuard hub
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/meshlink/server.env
WorkingDirectory=/opt/meshlink
ExecStart=/opt/meshlink/.venv/bin/uvicorn --factory server.main:create_app --host 127.0.0.1 --port 8443 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
